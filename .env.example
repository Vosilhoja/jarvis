# --- Обязательные ключи доступа ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
GOOGLE_API_KEY=your_google_genai_api_key_here
ALLOWED_TELEGRAM_USER_IDS=123456789

# --- Настройки ИИ ---
AI_MODEL_NAME=gemini-2.5-flash
AI_FALLBACK_MODEL_NAME=gemini-2.0-flash
AI_MAX_STEPS_PER_MESSAGE=15
AI_TEMPERATURE=0.2

# --- Приложения и поиск ---
APPS_SCAN_PATHS=
APPS_CACHE_TTL_HOURS=24
APP_MATCH_MIN_SCORE=60

# --- Напоминания и мониторинг ---
BACKGROUND_CHECK_INTERVAL_SEC=120
DISK_FREE_THRESHOLD_GB=10
CPU_LOAD_THRESHOLD_PERCENT=90
RAM_LOAD_THRESHOLD_PERCENT=90
TEMP_THRESHOLD_CELSIUS=85
APP_NOT_RESPONDING_TIMEOUT_SEC=15

# --- Голос (Speech-to-Text) ---
STT_PROVIDER=google
STT_LANGUAGE=ru-RU
